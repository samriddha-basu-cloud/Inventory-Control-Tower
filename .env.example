# Copy to .env for local overrides. Never commit real secrets.
ENVIRONMENT=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production            # REQUIRED in production
DATABASE_URL=sqlite:///instance/ict.db        # postgresql://user:pass@host:5432/ict in production
UPLOAD_LIMIT_MB=25
AUTH_REQUIRED=0                               # 1 = require sign-in (users seeded on first start)
ADMIN_PASSWORD=                               # password for seeded users when AUTH_REQUIRED=1 (random if empty; printed once)
API_KEY=                                      # X-API-Key for machine clients (FIT, ERP push)
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
NUMBER_STYLE=IN                               # IN = lakh/crore, INTL = K/M/B
JOBS_SYNC=1                                   # 1 = run heavy jobs inline; 0 = background thread pool
# Optional notification channels (all disabled unless set):
NOTIFY_WEBHOOK_URL=
NOTIFY_SLACK_URL=
NOTIFY_TEAMS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
